{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nobad.studio/find/contract/methods.schema.json",
  "title": "NOBAD Find engine: RPC methods",
  "description": "JSON-RPC 2.0 over \\\\.\\pipe\\NOBADFind-<user SID>, one JSON object per line, at most 1 MiB per line. Each method has the schema of its params and of its result. Plain-language descriptions: contract/README.md.",
  "protocol": 1,
  "methods": {
    "hello": {
      "description": "First call after connecting: the protocol version, the engine's version and process id, and every method and event it knows.",
      "params": {"$ref": "#/$defs/no_params"},
      "result": {
        "type": "object",
        "properties": {
          "protocol": {"type": "integer", "minimum": 1},
          "app": {"type": "string"},
          "version": {"type": "string"},
          "pid": {"type": "integer", "minimum": 0},
          "events": {"type": "array", "items": {"type": "string"}},
          "methods": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["protocol", "app", "version", "pid", "events", "methods"],
        "additionalProperties": false
      }
    },
    "subscribe": {
      "description": "Start getting these events on this connection. Unknown names are ignored. Notices that waited for a listener are sent before this reply.",
      "params": {"$ref": "#/$defs/event_names"},
      "result": {"$ref": "#/$defs/subscriptions"}
    },
    "unsubscribe": {
      "description": "Stop getting these events on this connection.",
      "params": {"$ref": "#/$defs/event_names"},
      "result": {"$ref": "#/$defs/subscriptions"}
    },
    "search": {
      "description": "Search the index. Empty text with no filter gives no results. filters is an object or left out (null is refused); its values must be the listed words.",
      "params": {
        "type": "object",
        "properties": {
          "text": {"type": "string", "maxLength": 2000, "description": "What the user typed; the engine uses the first 500 characters."},
          "filters": {"$ref": "#/$defs/filters"}
        },
        "additionalProperties": false,
        "examples": [{"text": "tax pdf"}, {"text": "", "filters": {"kind": "pdf", "sort": "newest"}}, {"text": ""}]
      },
      "result": {"$ref": "#/$defs/search_result"}
    },
    "open": {
      "description": "Open a result with its default program (outside NOBAD Find's process group).",
      "params": {"$ref": "#/$defs/id_params"},
      "result": {"$ref": "#/$defs/ok"}
    },
    "reveal": {
      "description": "Show a result selected in File Explorer.",
      "params": {"$ref": "#/$defs/id_params"},
      "result": {"$ref": "#/$defs/ok"}
    },
    "thumbnail": {
      "description": "A small preview from Windows' thumbnail cache for photos, videos and PDFs: a data: URL, or \"\" when there is none.",
      "params": {"$ref": "#/$defs/id_params"},
      "result": {
        "type": "object",
        "properties": {"url": {"type": "string", "pattern": "^(|data:image/(png|jpeg|bmp);base64,[A-Za-z0-9+/=]+)$"}},
        "required": ["url"],
        "additionalProperties": false
      }
    },
    "here_folder": {
      "description": "The File Explorer folder the hotkey was pressed in (\"here\" in a question), or \"\".",
      "params": {"$ref": "#/$defs/no_params"},
      "result": {"$ref": "#/$defs/path"}
    },
    "path_of": {
      "description": "The full path of a result, for Copy path. \"\" if it is no longer there.",
      "params": {"$ref": "#/$defs/id_params"},
      "result": {"$ref": "#/$defs/path"}
    },
    "forget": {
      "description": "Remove a result (file or folder) from the index and add it to the excluded folders.",
      "params": {"$ref": "#/$defs/id_params"},
      "result": {"$ref": "#/$defs/ok"}
    },
    "to_main": {
      "description": "The quick find bar's Alt+Enter: the engine sends a show event {what: main, text} so the main window comes up with these words.",
      "params": {
        "type": "object",
        "properties": {"text": {"type": "string", "maxLength": 2000}},
        "additionalProperties": false,
        "examples": [{"text": "tax pdf"}, {}]
      },
      "result": {"$ref": "#/$defs/done"}
    },
    "status": {
      "description": "The short status: the same object as the status event.",
      "params": {"$ref": "#/$defs/no_params"},
      "result": {"$ref": "#/$defs/status_brief"}
    },
    "status_full": {
      "description": "Everything the Indexing page shows: the same object as the status_full event.",
      "params": {"$ref": "#/$defs/no_params"},
      "result": {"$ref": "#/$defs/status_full"}
    },
    "pause_for": {
      "description": "Pause indexing for this many seconds (at most 24 hours; more is cut to 24 hours). Less than 1 is a bad-params error.",
      "params": {
        "type": "object",
        "properties": {"seconds": {"type": "integer", "minimum": 1}},
        "required": ["seconds"],
        "additionalProperties": false,
        "examples": [{"seconds": 3600}]
      },
      "result": {"$ref": "#/$defs/ok"}
    },
    "resume": {
      "description": "End a pause now.",
      "params": {"$ref": "#/$defs/no_params"},
      "result": {"$ref": "#/$defs/ok"}
    },
    "learned_apps": {
      "description": "What NOBAD Find learned about apps (games) it slowed down: program file names only.",
      "params": {"$ref": "#/$defs/no_params"},
      "result": {
        "type": "object",
        "properties": {"apps": {"type": "array", "items": {"$ref": "#/$defs/learned_app"}}},
        "required": ["apps"],
        "additionalProperties": false
      }
    },
    "reset_learned": {
      "description": "Forget what was learned about one app (exe), or about every app (exe null or left out).",
      "params": {
        "type": "object",
        "properties": {"exe": {"type": ["string", "null"], "maxLength": 260}},
        "additionalProperties": false,
        "examples": [{"exe": "game.exe"}, {}]
      },
      "result": {"$ref": "#/$defs/ok"}
    },
    "hardware": {
      "description": "The \"Your PC\" facts (measured once per engine run).",
      "params": {"$ref": "#/$defs/no_params"},
      "result": {"$ref": "#/$defs/hardware"}
    },
    "get_settings": {
      "description": "Every setting with its current value.",
      "params": {"$ref": "#/$defs/no_params"},
      "result": {"$ref": "#/$defs/settings"}
    },
    "set_settings": {
      "description": "Change settings. Each value is checked by the engine (settings.coerce): a value that doesn't fit becomes the default. Unknown names and wsearch_prev are ignored.",
      "params": {
        "type": "object",
        "properties": {"changes": {"$ref": "#/$defs/settings_changes"}},
        "required": ["changes"],
        "additionalProperties": false,
        "examples": [{"changes": {"theme": "light", "content_max_mb": 50}}, {"changes": {}}]
      },
      "result": {
        "type": "object",
        "properties": {
          "changed": {"type": "array", "items": {"type": "string"}, "description": "The names whose value really changed."},
          "settings": {"$ref": "#/$defs/settings"}
        },
        "required": ["changed", "settings"],
        "additionalProperties": false
      }
    },
    "pick_folder": {
      "description": "Windows' folder dialog, shown by the engine, topmost. The answer comes when the user closes it (no time limit: don't time this call out). path \"\" if cancelled. busy true (answered at once, path \"\"): a folder dialog was already open, and it was brought to the front again.",
      "params": {"$ref": "#/$defs/no_params"},
      "result": {
        "type": "object",
        "properties": {"path": {"type": "string"}, "busy": {"type": "boolean"}},
        "required": ["path", "busy"],
        "additionalProperties": false
      }
    },
    "rescan": {
      "description": "Walk every folder again now.",
      "params": {"$ref": "#/$defs/no_params"},
      "result": {"$ref": "#/$defs/ok"}
    },
    "wipe": {
      "description": "Delete the whole index and start over. Only with confirm \"DELETE\"; any other word gives ok false.",
      "params": {
        "type": "object",
        "properties": {"confirm": {"type": "string"}},
        "required": ["confirm"],
        "additionalProperties": false,
        "examples": [{"confirm": "DELETE"}, {"confirm": "no"}]
      },
      "result": {"$ref": "#/$defs/ok"}
    },
    "download_model": {
      "description": "Download the meaning model (needs allow_model_download). Progress comes as download events.",
      "params": {"$ref": "#/$defs/no_params"},
      "result": {"$ref": "#/$defs/ok"}
    },
    "download_photo_model": {
      "description": "Download the photo model (needs allow_photo_model_download). Progress comes as download events.",
      "params": {"$ref": "#/$defs/no_params"},
      "result": {"$ref": "#/$defs/ok"}
    },
    "wsearch_state": {
      "description": "How Windows Search indexing is set up now (runs sc.exe: about 100 ms).",
      "params": {"$ref": "#/$defs/no_params"},
      "result": {"$ref": "#/$defs/wsearch_state"}
    },
    "wsearch_set": {
      "description": "Turn Windows Search indexing off (off true) or back as it was (off false). Windows asks the user's permission; the answer comes after that prompt (don't time this call out). While one prompt is open, another call answers at once with ok false and a sentence.",
      "params": {
        "type": "object",
        "properties": {"off": {"type": "boolean"}},
        "required": ["off"],
        "additionalProperties": false,
        "examples": [{"off": true}, {"off": false}]
      },
      "result": {"$ref": "#/$defs/wsearch_change"}
    },
    "use_instead_of_windows_search": {
      "description": "One switch: Windows Search indexing off and NOBAD Find starts with Windows (on true), or Windows Search back as it was (on false). Asks permission like wsearch_set.",
      "params": {
        "type": "object",
        "properties": {"on": {"type": "boolean"}},
        "required": ["on"],
        "additionalProperties": false,
        "examples": [{"on": true}, {"on": false}]
      },
      "result": {"$ref": "#/$defs/wsearch_change"}
    },
    "ui_shown": {
      "description": "This UI's window came up (main by default). For the main window, indexing starts (the engine starts idle unless keep_background is on) or resumes after a close stopped it. Ignored once this connection's pipe has closed.",
      "params": {"$ref": "#/$defs/window_params"},
      "result": {"$ref": "#/$defs/done"}
    },
    "ui_hidden": {
      "description": "This UI's window was hidden or closed. For the main window, with \"Keep indexing in the background\" off, indexing stops and only the engine's idle process stays. A UI whose pipe closes counts as ui_hidden too.",
      "params": {"$ref": "#/$defs/window_params"},
      "result": {"$ref": "#/$defs/done"}
    },
    "quit": {
      "description": "End NOBAD Find (the engine, and so every UI). Only with confirm \"QUIT\"; any other word gives ok false. A quitting event goes out first, then the reply; the engine stops only after the reply is written, and what was written stays readable after the pipe closes.",
      "params": {
        "type": "object",
        "properties": {"confirm": {"type": "string"}},
        "required": ["confirm"],
        "additionalProperties": false,
        "examples": [{"confirm": "QUIT"}, {"confirm": "no"}]
      },
      "result": {"$ref": "#/$defs/ok"}
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["integer", "string"]},
        "method": {"type": "string"},
        "params": {"type": "object"}
      },
      "required": ["jsonrpc", "id", "method"],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["integer", "string"]},
        "result": true
      },
      "required": ["jsonrpc", "id", "result"],
      "additionalProperties": false
    },
    "error_response": {
      "description": "Codes: -32700 not JSON, -32600 not a request (also: message too big, then the pipe closes), -32601 unknown method, -32602 bad params, -32603 the engine failed (message never has details).",
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["integer", "string", "null"]},
        "error": {
          "type": "object",
          "properties": {
            "code": {"enum": [-32700, -32600, -32601, -32602, -32603]},
            "message": {"type": "string"}
          },
          "required": ["code", "message"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "error"],
      "additionalProperties": false
    },
    "no_params": {
      "type": "object",
      "additionalProperties": false,
      "examples": [{}]
    },
    "id_params": {
      "description": "A result id from search. Never a path: the engine looks the path up in the index.",
      "type": "object",
      "properties": {"id": {"type": "integer"}},
      "required": ["id"],
      "additionalProperties": false,
      "examples": [{"id": 7}, {"id": 999999}]
    },
    "window_params": {
      "type": "object",
      "properties": {"window": {"enum": ["main", "bar"], "default": "main"}},
      "additionalProperties": false,
      "examples": [{}, {"window": "main"}, {"window": "bar"}]
    },
    "event_names": {
      "type": "object",
      "properties": {"events": {"type": "array", "items": {"type": "string"}}},
      "required": ["events"],
      "additionalProperties": false,
      "examples": [{"events": ["status", "level", "activity", "download", "notice", "show", "here", "quitting"]}, {"events": []}]
    },
    "subscriptions": {
      "description": "Every event this connection gets now, sorted.",
      "type": "object",
      "properties": {"events": {"type": "array", "items": {"type": "string"}}},
      "required": ["events"],
      "additionalProperties": false
    },
    "ok": {
      "description": "Did it work; error is a plain sentence for the user when it didn't (\"\" when it did, or when there is nothing to say).",
      "type": "object",
      "properties": {"ok": {"type": "boolean"}, "error": {"type": "string"}},
      "required": ["ok", "error"],
      "additionalProperties": false
    },
    "done": {
      "type": "object",
      "properties": {"ok": {"const": true}},
      "required": ["ok"],
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "properties": {"path": {"type": "string"}},
      "required": ["path"],
      "additionalProperties": false
    },
    "filters": {
      "description": "The filter bar. Every key is optional; \"\" or a missing key means no filter.",
      "type": "object",
      "properties": {
        "kind": {"enum": ["", "pdf", "document", "spreadsheet", "slides", "text", "code", "email", "image", "video", "audio", "archive", "ebook", "app", "folder"]},
        "modified": {"enum": ["", "today", "week", "month", "year"]},
        "size": {"enum": ["", "small", "medium", "large"]},
        "folder": {"type": "string", "maxLength": 2000, "description": "\"here\", a known folder word (\"downloads\", \"desktop\", ...) or a folder path already in the index."},
        "sort": {"enum": ["", "newest", "oldest", "largest", "name"]}
      },
      "additionalProperties": false
    },
    "search_result": {
      "type": "object",
      "properties": {
        "results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
        "understood": {"type": "array", "items": {"type": "string"}, "description": "How the question was read, as chips (\"pdf\", \"last week\")."},
        "terms": {"type": "array", "items": {"type": "string"}, "description": "Words and phrases searched for (for highlighting)."},
        "notes": {"type": "array", "items": {"type": "string"}, "description": "Sentences for the user (e.g. a folder that isn't indexed)."},
        "more": {"type": "boolean", "description": "There were more matches than shown."},
        "ms": {"type": "integer", "minimum": 0},
        "error": {"type": "string", "description": "\"\" or a sentence when the search failed."}
      },
      "required": ["results", "understood", "terms", "notes", "more", "ms", "error"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "id": {"type": "integer"},
        "path": {"type": "string"},
        "name": {"type": "string"},
        "dir": {"type": "string"},
        "kind": {"type": "string"},
        "size": {"type": ["integer", "null"]},
        "mtime": {"type": ["number", "null"], "description": "Seconds since 1970 (UTC)."},
        "ago": {"type": "string", "description": "\"3 days ago\", or \"\"."},
        "why": {"type": "array", "items": {"type": "string"}},
        "snippet": {"type": "string", "description": "Text around the match (plain text; never markup)."},
        "weak": {"type": "boolean", "description": "Only a loose match: show it as less sure."}
      },
      "required": ["id", "path", "name", "dir", "kind", "size", "mtime", "ago", "why", "snippet", "weak"],
      "additionalProperties": false
    },
    "level": {"enum": ["full", "gentle", "light", "paused", ""]},
    "status_brief": {
      "type": "object",
      "properties": {
        "level": {"$ref": "#/$defs/level"},
        "reason": {"type": "string"},
        "phase": {"type": "string", "description": "starting, names, text, images, meaning, photos, watching, error"},
        "files": {"type": "integer", "minimum": 0},
        "paused": {"type": "string", "description": "\"\" or why indexing is paused."}
      },
      "required": ["level", "reason", "phase", "files", "paused"],
      "additionalProperties": false
    },
    "model_state": {
      "type": "object",
      "properties": {
        "state": {"enum": ["missing", "downloading", "ready"]},
        "got": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 0},
        "error": {"type": "string"}
      },
      "required": ["state", "got", "size", "error"],
      "additionalProperties": false
    },
    "drive": {
      "type": "object",
      "properties": {
        "root": {"type": "string"},
        "type": {"type": ["string", "null"]},
        "label": {"type": "string"},
        "present": {"type": "boolean"}
      },
      "required": ["root", "type", "label", "present"],
      "additionalProperties": false
    },
    "history_point": {
      "type": "object",
      "properties": {
        "t": {"type": "number"},
        "cpu": {"type": ["number", "null"]},
        "gpu": {"type": ["number", "null"]},
        "find_cpu": {"type": "number"},
        "find_mb": {"type": "number"},
        "level": {"$ref": "#/$defs/level"}
      },
      "required": ["t", "cpu", "gpu", "find_cpu", "find_mb", "level"],
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "pid": {"type": "integer"},
        "cpu": {"type": "number"},
        "memory_mb": {"type": "integer"}
      },
      "required": ["name", "pid", "cpu", "memory_mb"],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu": {"type": "number"},
        "memory_mb": {"type": "integer"},
        "read_mb_s": {"type": "number"},
        "gpu": {"type": ["number", "null"]},
        "processes": {"type": "array", "items": {"$ref": "#/$defs/process"}}
      },
      "required": ["cpu", "memory_mb", "read_mb_s", "gpu", "processes"],
      "additionalProperties": false
    },
    "phase": {
      "type": "object",
      "properties": {
        "id": {"enum": ["names", "text", "ocr", "meaning", "photos", "watching"]},
        "label": {"type": "string"},
        "state": {"enum": ["off", "running", "waiting", "done"]},
        "done": {"type": "integer", "minimum": 0},
        "total": {"type": ["integer", "null"]},
        "rate": {"type": "number", "description": "Items per second while running."},
        "eta_s": {"type": ["integer", "null"]}
      },
      "required": ["id", "label", "state", "done", "total", "rate", "eta_s"],
      "additionalProperties": false
    },
    "model_card": {
      "type": "object",
      "properties": {
        "id": {"enum": ["meaning", "photo", "ocr"]},
        "name": {"type": "string"},
        "license": {"type": "string"},
        "size_mb": {"type": "integer"},
        "on_disk": {"type": "boolean"},
        "loaded": {"type": "boolean"},
        "memory_mb": {"type": ["integer", "null"]},
        "device": {"type": "string"},
        "items": {"type": "integer"},
        "download": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "properties": {"got_mb": {"type": "number"}, "size_mb": {"type": "number"}, "mb_s": {"type": "number"}},
              "required": ["got_mb", "size_mb", "mb_s"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["id", "name", "license", "size_mb", "on_disk", "loaded", "memory_mb", "device", "items", "download"],
      "additionalProperties": false
    },
    "activity_entry": {
      "type": "object",
      "properties": {
        "t": {"type": "number", "description": "Seconds since 1970 (UTC)."},
        "kind": {"enum": ["level", "kill", "model", "info"]},
        "text": {"type": "string"}
      },
      "required": ["t", "kind", "text"],
      "additionalProperties": false
    },
    "status_full": {
      "description": "Extra keys may appear (indexer details such as speed, error); the listed ones are always there.",
      "type": "object",
      "properties": {
        "phase": {"type": "string"},
        "files": {"type": "integer", "minimum": 0},
        "texts": {"type": "integer", "minimum": 0},
        "vectors": {"type": "integer", "minimum": 0},
        "paused": {"type": "string"},
        "rate": {"type": "number"},
        "errors": {"type": "integer"},
        "plan": {"type": "object"},
        "last_scan": {"type": "number"},
        "with_text": {"type": "integer"},
        "chunks": {"type": "integer"},
        "name_vectors": {"type": "integer"},
        "photo_vectors": {"type": "integer"},
        "encrypted": {"type": "boolean"},
        "db_bytes": {"type": "integer"},
        "version": {"type": "string"},
        "model": {"$ref": "#/$defs/model_state"},
        "photo_model": {"$ref": "#/$defs/model_state"},
        "memory_mb": {"type": "integer"},
        "models_loaded": {"type": "array", "items": {"type": "string"}},
        "admin": {"type": "boolean"},
        "roots": {"type": "array", "items": {"type": "string"}},
        "ocr": {"description": "true when Windows OCR works, else a sentence saying why not (\"\" if unknown).", "type": ["boolean", "string"]},
        "drives": {"type": "array", "items": {"$ref": "#/$defs/drive"}},
        "level": {"$ref": "#/$defs/level"},
        "reason": {"type": "string"},
        "history": {"type": "array", "items": {"$ref": "#/$defs/history_point"}, "description": "The last 5 minutes, one point per governor tick (2 s)."},
        "resources": {"$ref": "#/$defs/resources"},
        "phases": {"type": "array", "items": {"$ref": "#/$defs/phase"}},
        "models": {"type": "array", "items": {"$ref": "#/$defs/model_card"}},
        "activity": {"type": "array", "items": {"$ref": "#/$defs/activity_entry"}, "description": "Newest first, at most 50."}
      },
      "required": ["phase", "files", "texts", "vectors", "paused", "rate", "errors", "plan", "last_scan", "with_text",
                   "chunks", "name_vectors", "photo_vectors", "encrypted", "db_bytes", "version", "model",
                   "photo_model", "memory_mb", "models_loaded", "admin", "roots", "ocr", "drives", "level", "reason",
                   "history", "resources", "phases", "models", "activity"],
      "additionalProperties": true
    },
    "learned_app": {
      "type": "object",
      "properties": {
        "exe": {"type": "string"},
        "seen": {"type": "integer"},
        "lag_events": {"type": "integer"},
        "worst_cpu": {"type": ["number", "null"]},
        "worst_gpu": {"type": ["number", "null"]},
        "start_level": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/level"}]},
        "last_seen": {"type": ["number", "null"]},
        "reason": {"type": "string"}
      },
      "required": ["exe", "seen", "lag_events", "worst_cpu", "worst_gpu", "start_level", "last_seen", "reason"],
      "additionalProperties": false
    },
    "hardware": {
      "type": "object",
      "properties": {
        "ram_gb": {"type": "number"},
        "cores": {"type": "integer"},
        "threads": {"type": "integer"},
        "avx2": {"type": "boolean"},
        "avx512_vnni": {"type": "boolean"},
        "gpu": {"type": "string"},
        "vram_gb": {"type": "number"},
        "directml": {"type": "boolean"},
